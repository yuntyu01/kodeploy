apiVersion: batch/v1
kind: Job                                                # 일회성 작업 — 성공할 때까지 Pod을 실행 후 종료
metadata:
  name: build-{{ (user_id|string)[:8] }}-{{ build_id }}  # user_id 앞 8자 + build_id 8자 → 충돌 회피
  namespace: kodeploy-build
  labels:
    app: kodeploy-build
    build-id: "{{ build_id }}"                           # service.py가 라벨로 Pod 찾아 로그 조회
    user-id: "{{ user_id }}"
    build-mode: dockerfile
spec:
  ttlSecondsAfterFinished: 1200                          # 종료 후 N초 뒤 Job/Pod 자동 삭제 (20분)
  backoffLimit: 0                                        # 실패 시 재시도 횟수 — 0이면 한 번만 시도
  template:
    metadata:
      labels:
        app: kodeploy-build
        build-id: "{{ build_id }}"
    spec:
      restartPolicy: Never                               # Pod 컨테이너 실패 시 재시작 X (Job 정책상 Never/OnFailure만 허용)
      # nixpacks/static과 동일 패턴: init이 repo를 emptyDir에 clone, main(BuildKit)은 로컬 context로 빌드.
      # BuildKit git-context 인증(버전 의존)에 기대지 않고, init에서 git clone + URL rewrite로 private repo 처리.
      initContainers:
        - name: clone
          image: alpine/git:latest                       # git 포함 alpine
          command: [sh, -c]
          env:
            - name: REPO_URL
              value: "{{ repo_url }}"
            - name: BRANCH
              value: "{{ branch }}"
{% if git_auth_secret %}
            - name: GIT_AUTH_TOKEN                        # private repo clone 전용 (빌드별 Secret, etcd 암호화됨). main 컨테이너엔 불필요
              valueFrom:
                secretKeyRef:
                  name: {{ git_auth_secret }}
                  key: GIT_AUTH_TOKEN
{% endif %}
          args:
            - |
              set -eu
              echo "[1/1] cloning ${REPO_URL} (${BRANCH})..."
              # private repo: 토큰을 URL rewrite(insteadOf)로 주입 — REPO_URL/로그엔 토큰 안 보임(set -x 꺼짐)
              if [ -n "${GIT_AUTH_TOKEN:-}" ]; then
                git config --global url."https://x-access-token:${GIT_AUTH_TOKEN}@github.com/".insteadOf "https://github.com/"
              fi
              git clone --depth 1 -b "$BRANCH" "$REPO_URL" /workspace/src
          volumeMounts:
            - name: workspace
              mountPath: /workspace
      containers:
        - name: buildkit
          image: {{ buildkit_image }}
          securityContext:                               # rootless BuildKit 권장 보안 설정
            seccompProfile:
              type: Unconfined                           # rootless 빌드에 필요한 syscall 허용
            runAsUser: 1000                              # 비-root UID로 실행
            runAsGroup: 1000
          command:
            - buildctl-daemonless.sh                     # 데몬리스 — buildkitd 잠깐 띄웠다 빌드 후 자동 종료
          args:
            - build
            - --frontend=dockerfile.v0                   # Dockerfile v0 문법 사용
            # context = clone된 소스(+선택 subdir). 유저 Dockerfile은 그 안에 있음 (filename으로 지정).
            - --local=context=/workspace/src{% if dockerfile_subdir %}/{{ dockerfile_subdir }}{% endif %}
            - --local=dockerfile=/workspace/src{% if dockerfile_subdir %}/{{ dockerfile_subdir }}{% endif %}
            - --opt=filename={{ dockerfile_filename }}    # context 기준 Dockerfile 파일명
            - --output=type=image,name={{ image }},push=true  # 빌드 결과를 GHCR로 즉시 push
          env:
            - name: BUILDKITD_FLAGS
              value: --oci-worker-no-process-sandbox     # rootless에서 K8s 샌드박스 충돌 회피
          volumeMounts:
            - name: workspace
              mountPath: /workspace
            - name: docker-config
              mountPath: /home/user/.docker              # ~/.docker/config.json 표준 경로 (BuildKit이 여기서 인증 정보 읽음)
              readOnly: true
      volumes:
        - name: workspace
          emptyDir: {}                                   # init과 main 사이 파일 공유 — Pod 종료 시 자동 GC
        - name: docker-config
          secret:                                        # dockerconfigjson Secret을 config.json 파일로 투영
            secretName: {{ ghcr_auth_secret }}
            items:
              - key: .dockerconfigjson                   # Secret 안의 키
                path: config.json                        # 마운트된 디렉토리 안에서의 파일명
