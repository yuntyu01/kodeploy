apiVersion: batch/v1
kind: Job                                                # static 런타임 빌드: clone → 플랫폼 생성 Dockerfile → BuildKit
metadata:
  name: build-{{ (user_id|string)[:8] }}-{{ build_id }}  # dockerfile/auto 모드와 동일 패턴
  namespace: kodeploy-build
  labels:
    app: kodeploy-build
    build-id: "{{ build_id }}"                           # service.py가 라벨로 Pod 찾아 로그 조회
    user-id: "{{ user_id }}"
    build-mode: static
spec:
  ttlSecondsAfterFinished: 1200                          # 종료 후 20분 뒤 자동 삭제
  backoffLimit: 0
  activeDeadlineSeconds: {{ active_deadline_seconds }}    # Job 전체 상한 — early-trigger 후 export가 무한히 도는 걸 컷
  template:
    metadata:
      labels:
        app: kodeploy-build
        build-id: "{{ build_id }}"
    spec:
      restartPolicy: Never
      # nixpacks Job과 같은 패턴: init이 emptyDir에 context+Dockerfile 준비, main이 빌드.
      # Dockerfile은 repo에 없고 플랫폼이 렌더 — base64로 넘겨 셸/YAML 이스케이프 원천 차단.
      initContainers:
        - name: clone
          image: alpine/git:latest
          command: [sh, -c]
          env:
            - name: REPO_URL
              value: "{{ repo_url }}"
            - name: BRANCH
              value: "{{ branch }}"
            - name: DOCKERFILE_B64
              value: "{{ dockerfile_b64 }}"
{% if git_auth_secret %}
            - name: GIT_AUTH_TOKEN                        # private repo clone용 (빌드별 Secret, etcd 암호화됨)
              valueFrom:
                secretKeyRef:
                  name: {{ git_auth_secret }}
                  key: GIT_AUTH_TOKEN
{% endif %}
          args:
            - |
              set -eu
              echo "[1/2] cloning ${REPO_URL} (${BRANCH})..."
              # private repo: 토큰을 URL rewrite로 주입 — REPO_URL/로그엔 토큰 안 보임(set -x 꺼짐)
              if [ -n "${GIT_AUTH_TOKEN:-}" ]; then
                git config --global url."https://x-access-token:${GIT_AUTH_TOKEN}@github.com/".insteadOf "https://github.com/"
              fi
              git clone --depth 1 -b "$BRANCH" "$REPO_URL" /workspace/src
              echo "[2/2] writing generated Dockerfile..."
              mkdir -p /workspace/df
              echo "$DOCKERFILE_B64" | base64 -d > /workspace/df/Dockerfile
              echo "===KODEPLOY_DOCKERFILE_START==="
              cat /workspace/df/Dockerfile
              echo "===KODEPLOY_DOCKERFILE_END==="
          volumeMounts:
            - name: workspace
              mountPath: /workspace
      containers:
        - name: buildkit
          image: {{ buildkit_image }}
          securityContext:
            seccompProfile:
              type: Unconfined
            runAsUser: 1000
            runAsGroup: 1000
          command:
            - buildctl-daemonless.sh
          args:
            - build
            - --frontend=dockerfile.v0
            # context는 clone된 소스(+선택 서브디렉토리), Dockerfile은 별도 디렉토리 — nixpacks 모드와 동일한 --local 조합
            - --local=context=/workspace/src{% if project_path %}/{{ project_path }}{% endif %}
            - --local=dockerfile=/workspace/df
            - --opt=filename=Dockerfile
            - --output=type=image,name={{ image }},push=true
{% if registry_cache %}
            - --import-cache=type=registry,ref={{ cache_ref }}
            - --export-cache=type=registry,ref={{ cache_ref }},mode=max
{% endif %}
          env:
            - name: BUILDKITD_FLAGS
              value: --oci-worker-no-process-sandbox
          volumeMounts:
            - name: workspace
              mountPath: /workspace
            - name: docker-config
              mountPath: /home/user/.docker
              readOnly: true
      volumes:
        - name: workspace
          emptyDir: {}                                   # init과 main 사이 파일 공유 — Pod 종료 시 자동 GC
        - name: docker-config
          secret:
            secretName: {{ ghcr_auth_secret }}
            items:
              - key: .dockerconfigjson
                path: config.json
