apiVersion: v1
kind: Secret                                             # mysql 자격증명 — 비번은 백엔드가 자동 생성해서 주입
metadata:
  name: mysql-secret
  namespace: {{ tenant_id }}
  labels:
    app: mysql
    component: mysql
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
type: Opaque
stringData:                                              # base64 인코딩 안 해도 K8s가 자동 처리 (data와 달리)
  MYSQL_ROOT_PASSWORD: {{ root_password }}               # 백엔드 secrets.token_urlsafe(24)로 생성
  MYSQL_USER: {{ username }}
  MYSQL_PASSWORD: {{ password }}
---
apiVersion: v1
kind: Service
metadata:
  name: mysql                                            # ns 안에서 유일하면 됨 — 짧고 의미 있는 이름
  namespace: {{ tenant_id }}                             # 테넌트 ns가 격리 단위
  labels:
    app: mysql
    component: mysql
    tenant: {{ tenant_id }}                              # 테넌트 라벨 (kubectl ... -l tenant=xxx 일괄 조회용)
    user: "{{ user_id }}"                                # 유저 라벨
    managed-by: kodeploy
spec:
  clusterIP: None                                        # headless — StatefulSet Pod마다 안정적 DNS 부여
  selector:
    app: mysql                                           # 이 라벨 가진 Pod을 endpoint로
  ports:
    - port: 3306
      targetPort: 3306
      name: mysql                                        # 포트 이름 (다른 리소스가 이름으로 참조 가능)
---
apiVersion: apps/v1
kind: StatefulSet                                        # DB·메시지큐 같은 stateful 앱용 — 안정적 이름/스토리지
metadata:
  name: mysql
  namespace: {{ tenant_id }}
  labels:
    app: mysql
    component: mysql
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
spec:
  serviceName: mysql                                     # 위 headless Service 이름과 일치해야 Pod DNS 살아남
  replicas: 1
  selector:
    matchLabels:
      app: mysql
  template:
    metadata:
      labels:
        app: mysql
        component: mysql
        tenant: {{ tenant_id }}                          # Pod에도 라벨 박아야 셀렉터 일괄 조회 가능
        user: "{{ user_id }}"
    spec:
      containers:
        - name: mysql
          image: mysql:8.4
          ports:
            - containerPort: 3306
              name: mysql
          env:                                           # 시크릿 키 이름 = envvar 이름 (운영 mysql-secret과 동일 컨벤션)
            - name: MYSQL_ROOT_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mysql-secret                     # 같은 ns의 mysql-secret 참조 (별도로 만들어야 함)
                  key: MYSQL_ROOT_PASSWORD
            - name: MYSQL_DATABASE
              value: {{ database | default("app") }}     # 부팅 시 자동 생성될 DB 이름
            - name: MYSQL_USER
              valueFrom:
                secretKeyRef:
                  name: mysql-secret
                  key: MYSQL_USER
            - name: MYSQL_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mysql-secret
                  key: MYSQL_PASSWORD
          args:
            - --innodb-buffer-pool-size=128M             # 기본 75% → 128M로 못박아 OOM 방지
            - --max-connections=50                       # 기본 151 → 50 (커넥션 폭주 방지)
          resources:
            requests:
              cpu: {{ req_cpu }}m                        # 스케줄러 보장값
              memory: {{ req_mem }}Mi
            limits:
              cpu: {{ lim_cpu }}m                        # 런타임 상한 (초과 시 throttle / OOMKill)
              memory: {{ lim_mem }}Mi
          startupProbe:                                  # 부팅 단계 전용. 통과 전엔 liveness/readiness 멈춤
            tcpSocket:
              port: 3306                                 # TCP 연결만 확인 (mysqladmin은 인증 필요해서 회피)
            failureThreshold: 30                         # 실패 N회까지 허용
            periodSeconds: 5                             # N초마다 체크 → 최대 150초까지 부팅 허용
          livenessProbe:                                 # 프로세스 살아있나 — 실패 시 컨테이너 재시작
            tcpSocket:
              port: 3306
            periodSeconds: 10
            failureThreshold: 3                          # 연속 N회 실패 시 재시작 (30초)
          readinessProbe:                                # 트래픽 받을 준비 됐나 — 실패 시 endpoint에서만 제외
            tcpSocket:
              port: 3306
            periodSeconds: 5
            failureThreshold: 3                          # 연속 N회 실패 시 endpoint 제외 (15초)
          volumeMounts:
            - name: data
              mountPath: /var/lib/mysql                  # MySQL 데이터 디렉토리 → PVC로 영구화
  volumeClaimTemplates:                                  # Pod마다 자동 PVC 생성 (재시작/이동해도 같은 볼륨에 재바인딩)
    - metadata:
        name: data
      spec:
        accessModes:
          - ReadWriteOnce                                # 한 노드에서만 read/write
        storageClassName: {{ storage_class | default("local-path") }}  # 동적 프로비저너 이름 (Rancher local-path 기본)
        resources:
          requests:
            storage: {{ storage | default("5Gi") }}
