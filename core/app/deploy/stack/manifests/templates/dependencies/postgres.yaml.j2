apiVersion: v1
kind: Secret                                             # postgres 자격증명 — 비번은 백엔드가 자동 생성해서 주입
metadata:
  name: postgres-secret
  namespace: {{ tenant_id }}
  labels:
    app: postgres
    component: postgres
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
type: Opaque
stringData:                                              # base64 인코딩 안 해도 K8s가 자동 처리
  POSTGRES_USER: {{ username }}
  POSTGRES_PASSWORD: {{ password }}
  POSTGRES_DB: {{ database | default("app") }}
  # 앱 컨테이너에 envFrom으로 일괄 주입되는 표준 키 (mysql과 동일 컨벤션 — DB_*가 db 종류 무관)
  DB_HOST: postgres                                      # 같은 ns headless Service 이름
  DB_PORT: "5432"
  DB_NAME: {{ database | default("app") }}
  DB_USER: {{ username }}
  DB_PASSWORD: {{ password }}
  # Spring Boot Relaxed Binding 자동 인식 — application.properties 수정 0
  SPRING_DATASOURCE_URL: jdbc:postgresql://postgres:5432/{{ database | default("app") }}
  SPRING_DATASOURCE_USERNAME: {{ username }}
  SPRING_DATASOURCE_PASSWORD: {{ password }}
  # SQLAlchemy 등 Python OSS 표준
  DATABASE_URL: postgresql+psycopg2://{{ username }}:{{ password }}@postgres:5432/{{ database | default("app") }}
---
apiVersion: v1
kind: Service
metadata:
  name: postgres                                         # ns 안에서 유일하면 됨 — 짧고 의미 있는 이름
  namespace: {{ tenant_id }}
  labels:
    app: postgres
    component: postgres
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
spec:
  clusterIP: None                                        # headless — StatefulSet Pod마다 안정적 DNS 부여
  selector:
    app: postgres                                        # 이 라벨 가진 Pod을 endpoint로
  ports:
    - port: 5432
      targetPort: 5432
      name: postgres
---
apiVersion: apps/v1
kind: StatefulSet                                        # DB·메시지큐 같은 stateful 앱용 — 안정적 이름/스토리지
metadata:
  name: postgres
  namespace: {{ tenant_id }}
  labels:
    app: postgres
    component: postgres
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
spec:
  serviceName: postgres                                  # 위 headless Service 이름과 일치해야 Pod DNS 살아남
  replicas: 1
  selector:
    matchLabels:
      app: postgres
  template:
    metadata:
      labels:
        app: postgres
        component: postgres
        tenant: {{ tenant_id }}                          # Pod에도 라벨 박아야 셀렉터 일괄 조회 가능
        user: "{{ user_id }}"
    spec:
      # PSS restricted 호환 — postgres:16-alpine 이미지의 postgres user(UID 70)로 실행.
      # fsGroup으로 volume ownership 자동 chown.
      securityContext:
        runAsNonRoot: true
        runAsUser: 70
        runAsGroup: 70
        fsGroup: 70
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: postgres
          image: postgres:16-alpine
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          ports:
            - containerPort: 5432
              name: postgres
          env:
            - name: POSTGRES_USER
              valueFrom:
                secretKeyRef:
                  name: postgres-secret
                  key: POSTGRES_USER
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-secret
                  key: POSTGRES_PASSWORD
            - name: POSTGRES_DB
              value: {{ database | default("app") }}     # 부팅 시 자동 생성될 DB 이름
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata     # 볼륨 root 직접 init 안 하게 (lost+found 충돌 방지)
          resources:
            requests:
              cpu: {{ req_cpu }}m                        # 스케줄러 보장값
              memory: {{ req_mem }}Mi
            limits:
              cpu: {{ lim_cpu }}m                        # 런타임 상한 (초과 시 throttle / OOMKill)
              memory: {{ lim_mem }}Mi
          startupProbe:                                  # 부팅 단계 전용
            tcpSocket:
              port: 5432
            failureThreshold: 30                         # 최대 150초까지 부팅 허용
            periodSeconds: 5
          livenessProbe:                                 # 프로세스 살아있나
            tcpSocket:
              port: 5432
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:                                # 트래픽 받을 준비 됐나
            tcpSocket:
              port: 5432
            periodSeconds: 5
            failureThreshold: 3
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data        # PGDATA의 부모 — pgdata 서브디렉토리에 실제 데이터
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes:
          - ReadWriteOnce                                # 한 노드에서만 read/write
        storageClassName: {{ storage_class | default("local-path") }}
        resources:
          requests:
            storage: {{ storage | default("5Gi") }}
