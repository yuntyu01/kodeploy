apiVersion: v1
kind: Service                                            # Pod IP 변동에 안 흔들리는 안정적 가상 IP/DNS 부여
metadata:
  name: {{ app_name }}                                   # 유저 앱 이름 (repo에서 파생)
  namespace: {{ tenant_id }}                             # 테넌트 ns가 격리 단위
  labels:
    app: {{ app_name }}
    tenant: {{ tenant_id }}                              # 테넌트 라벨
    user: "{{ user_id }}"                                # 유저 라벨
    managed-by: kodeploy
spec:
  selector:
    app: {{ app_name }}                                  # 이 라벨 가진 Pod을 endpoint로 등록
  ports:
    - port: {{ port }}                                   # Service가 노출하는 포트 (다른 Pod이 부르는 번호)
      targetPort: {{ port }}                             # 백엔드 Pod의 containerPort
      protocol: TCP
  type: ClusterIP                                        # 클러스터 내부 전용 — 외부 노출은 Gateway/HTTPRoute가 담당
