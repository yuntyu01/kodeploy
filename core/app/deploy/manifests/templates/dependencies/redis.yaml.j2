apiVersion: v1
kind: Secret
metadata:
  name: redis-secret
  namespace: {{ tenant_id }}
  labels:
    app: redis
    component: redis
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
type: Opaque
stringData:
  REDIS_PASSWORD: {{ password }}
  REDIS_HOST: redis
  REDIS_PORT: "6379"
  REDIS_URL: redis://:{{ password }}@redis:6379/0
  SPRING_DATA_REDIS_HOST: redis
  SPRING_DATA_REDIS_PORT: "6379"
  SPRING_DATA_REDIS_PASSWORD: {{ password }}
---
apiVersion: v1
kind: Service
metadata:
  name: redis
  namespace: {{ tenant_id }}
  labels:
    app: redis
    component: redis
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
spec:
  clusterIP: None
  selector:
    app: redis
  ports:
    - port: 6379
      targetPort: 6379
      name: redis
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: redis
  namespace: {{ tenant_id }}
  labels:
    app: redis
    component: redis
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
spec:
  replicas: 1
  selector:
    matchLabels:
      app: redis
  template:
    metadata:
      labels:
        app: redis
        component: redis
        tenant: {{ tenant_id }}
        user: "{{ user_id }}"
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
        runAsGroup: 999
        fsGroup: 999
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: redis
          image: redis:7-alpine
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          command: ["redis-server", "--requirepass", "$(REDIS_PASSWORD)", "--maxmemory", "128mb", "--maxmemory-policy", "allkeys-lru"]
          env:
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: redis-secret
                  key: REDIS_PASSWORD
          ports:
            - containerPort: 6379
              name: redis
          resources:
            requests:
              cpu: {{ req_cpu }}m
              memory: {{ req_mem }}Mi
            limits:
              cpu: {{ lim_cpu }}m
              memory: {{ lim_mem }}Mi
          startupProbe:
            tcpSocket:
              port: 6379
            failureThreshold: 10
            periodSeconds: 3
          livenessProbe:
            tcpSocket:
              port: 6379
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:
            tcpSocket:
              port: 6379
            periodSeconds: 5
            failureThreshold: 3
