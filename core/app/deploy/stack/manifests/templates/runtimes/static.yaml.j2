apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app_name }}                                   # 유저 앱 이름 (repo에서 파생)
  namespace: {{ tenant_id }}                             # 테넌트 ns가 격리 단위
  labels:
    app: {{ app_name }}
    runtime: static                                      # 런타임 라벨 — 셀렉터로 종류별 일괄 조회 가능
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
spec:
  replicas: {{ replicas | default(1) }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: {{ app_name }}
  template:
    metadata:
      labels:
        app: {{ app_name }}
        runtime: static
        tenant: {{ tenant_id }}
        user: "{{ user_id }}"
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000                                  # nginx-unprivileged는 임의 UID 동작 설계 (OpenShift 호환) — 다른 런타임과 동일하게 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: app
          image: {{ image }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          ports:
            - containerPort: {{ port | default(8080) }}  # nginx-unprivileged 기본 listen 포트 — service.py가 8080 고정
          # 정적 서빙이라 DB/R2 secretRef 불필요. {app}-env만 유지 (다른 런타임과 동작 일치 — nginx는 안 읽지만 무해)
          envFrom:
            - secretRef:
                name: {{ app_name }}-env
                optional: true
          resources:
            requests:
              cpu: {{ req_cpu }}m                        # 스케줄러 보장값
              memory: {{ req_mem }}Mi
              ephemeral-storage: {{ req_eph }}Mi         # nginx temp 파일용 소량
            limits:
              cpu: {{ lim_cpu }}m
              memory: {{ lim_mem }}Mi
              ephemeral-storage: {{ lim_eph }}Mi         # 초과 시 이 Pod만 evict — 노드/타 테넌트 보호
          startupProbe:                                  # nginx는 ms 단위 기동 — python/java보다 짧게
            httpGet:
              path: /
              port: {{ port | default(8080) }}
            failureThreshold: 6
            periodSeconds: 5                             # 최대 30초까지 부팅 허용
          livenessProbe:
            httpGet:
              path: /
              port: {{ port | default(8080) }}
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /
              port: {{ port | default(8080) }}
            periodSeconds: 5
            failureThreshold: 3
      imagePullSecrets:
        - name: {{ ghcr_auth_secret }}                   # private GHCR 이미지 pull용
