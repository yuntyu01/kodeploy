apiVersion: v1
kind: Secret                                             # R2 S3 자격증명 — r2.provision()이 CF API로 발급한 값 주입
metadata:
  name: r2-secret
  namespace: {{ tenant_id }}
  labels:
    app: r2
    component: storage
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
  annotations:
    # 정리(deprovision) 시 이 토큰을 revoke. stringData에 안 넣어 앱 env로 새지 않게 함.
    kodeploy.com/r2-token-id: "{{ token_id }}"
type: Opaque
stringData:                                              # 앱 Pod에 envFrom으로 일괄 주입 (mysql-secret과 동일 방식)
{% for key, value in env.items() %}
  {{ key }}: {{ value | tojson }}
{% endfor %}
