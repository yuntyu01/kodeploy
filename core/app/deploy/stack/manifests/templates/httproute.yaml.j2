apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ app_name }}
  namespace: {{ tenant_id }}
  labels:
    app: {{ app_name }}
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
spec:
  parentRefs:
    - name: kodeploy
      namespace: default
      sectionName: https
  hostnames:                                             # 호출자가 슬롯 규칙으로 계산해 주입 (server/static 분배)
{% for h in hostnames %}
    - {{ h }}
{% endfor %}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
{% if origin_verify_secret %}
          headers:
            - type: Exact
              name: X-Origin-Verify
              value: "{{ origin_verify_secret }}"
{% endif %}
      backendRefs:
        - name: {{ app_name }}
          port: {{ port }}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ app_name }}-redirect
  namespace: {{ tenant_id }}
  labels:
    app: {{ app_name }}
    tenant: {{ tenant_id }}
    user: "{{ user_id }}"
    managed-by: kodeploy
spec:
  parentRefs:
    - name: kodeploy
      namespace: default
      sectionName: http
  hostnames:
{% for h in hostnames %}
    - {{ h }}
{% endfor %}
  rules:
    - filters:
        - type: RequestRedirect
          requestRedirect:
            scheme: https
            statusCode: 301
